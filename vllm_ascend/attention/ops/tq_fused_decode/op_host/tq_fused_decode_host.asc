#include "../op_kernel/tq_fused_decode_kernel.asc"
#include "data_utils.h"
#include <acl/acl.h>

#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

// Direct-invoke host entry point for testing
// Reads input binary files, runs kernel, writes output binary files

int32_t g_deviceId = 0;

static void ComputeTiling(TqFusedDecodeTilingData& tiling,
                          uint32_t batchSize, uint32_t numQueryHeads,
                          uint32_t numKvHeads, uint32_t blockSize,
                          uint32_t headDim, uint32_t maxBlocksPerSeq,
                          uint32_t normCorrection, float smScale) {
    tiling.batchSize = batchSize;
    tiling.numQueryHeads = numQueryHeads;
    tiling.numKvHeads = numKvHeads;
    tiling.gqaRatio = numQueryHeads / numKvHeads;
    tiling.gridSize = batchSize * numQueryHeads;
    tiling.blockSize = blockSize;
    tiling.headDim = headDim;
    tiling.mseBytes = 64;    // ceil(128 * 4 / 8)
    tiling.keyPackedSize = 66; // 64 + 2
    tiling.valDataBytes = 64;  // ceil(128 * 4 / 8)
    tiling.slotSize = 134;     // 66 + 64 + 2 + 2
    tiling.maxBlocksPerSeq = maxBlocksPerSeq;
    tiling.blockStride = static_cast<uint64_t>(blockSize) * numKvHeads * 134;
    tiling.slotStride = static_cast<uint64_t>(numKvHeads) * 134;
    tiling.normCorrection = normCorrection;
    tiling.smScale = smScale;
}

void KernelCall(aclrtStream stream, uint32_t blockNum,
                void* queryDev, void* kvCacheDev, void* blockTableDev,
                void* seqLensDev, void* centroidsDev, void* outputDev,
                void* tilingDev, const TqFusedDecodeTilingData& tiling) {
    // Copy tiling to device
    aclrtMemcpy(tilingDev, sizeof(TqFusedDecodeTilingData),
                &tiling, sizeof(TqFusedDecodeTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    // Launch kernel
    tq_fused_decode_kernel<<<blockNum, nullptr, stream>>>(
        queryDev, kvCacheDev, blockTableDev, seqLensDev,
        centroidsDev, outputDev, tilingDev);

    aclrtSynchronizeStream(stream);
}

int main() {
    // ACL initialization
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) { printf("aclInit failed\n"); return 1; }
    ret = aclrtSetDevice(g_deviceId);
    if (ret != ACL_SUCCESS) { printf("aclrtSetDevice failed\n"); return 1; }

    aclrtStream stream;
    aclrtCreateStream(&stream);

    // Query vector core count
    uint32_t coreCount = 0;
    aclrtGetDeviceInfo(g_deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount);
    printf("Available vector cores: %u\n", coreCount);

    // Test parameters (small test)
    uint32_t B = 1, Hq = 32, Hk = 8, blockSize = 16, headDim = 128;
    uint32_t seqLen = 32;
    uint32_t maxBlocks = (seqLen + blockSize - 1) / blockSize;
    uint32_t numBlocks = maxBlocks;
    float smScale = 1.0f / sqrtf(128.0f);

    TqFusedDecodeTilingData tiling;
    ComputeTiling(tiling, B, Hq, Hk, blockSize, headDim, maxBlocks, 1, smScale);

    uint32_t gridSize = B * Hq;
    uint32_t usedCores = (coreCount < gridSize) ? coreCount : gridSize;

    // Allocate device memory
    size_t querySize = B * Hq * headDim * sizeof(uint16_t);  // fp16
    size_t kvCacheSize = numBlocks * blockSize * Hk * 134;   // uint8
    size_t blockTableSize = B * maxBlocks * sizeof(int32_t);
    size_t seqLensSize = B * sizeof(int32_t);
    size_t centroidsSize = 16 * sizeof(float);
    size_t outputSize = B * Hq * headDim * sizeof(uint16_t);  // fp16
    size_t tilingSize = sizeof(TqFusedDecodeTilingData);

    void *queryDev, *kvCacheDev, *blockTableDev, *seqLensDev;
    void *centroidsDev, *outputDev, *tilingDev;

    // Read input data from files
    std::vector<uint8_t> queryBuf(querySize);
    std::vector<uint8_t> kvCacheBuf(kvCacheSize);
    std::vector<uint8_t> blockTableBuf(blockTableSize);
    std::vector<uint8_t> seqLensBuf(seqLensSize);
    std::vector<float> centroidsBuf(16);

    ReadFile("input/query.bin", queryBuf.data(), querySize);
    ReadFile("input/kv_cache.bin", kvCacheBuf.data(), kvCacheSize);
    ReadFile("input/block_table.bin", blockTableBuf.data(), blockTableSize);
    ReadFile("input/seq_lens.bin", seqLensBuf.data(), seqLensSize);
    ReadFile("input/centroids.bin", centroidsBuf.data(), centroidsSize);

    // Allocate device memory
    aclrtMalloc(&queryDev, querySize, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&kvCacheDev, kvCacheSize, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&blockTableDev, blockTableSize, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&seqLensDev, seqLensSize, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&centroidsDev, centroidsSize, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&outputDev, outputSize, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&tilingDev, tilingSize, ACL_MEM_MALLOC_NORMAL_ONLY);

    // Copy inputs to device
    aclrtMemcpy(queryDev, querySize, queryBuf.data(), querySize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(kvCacheDev, kvCacheSize, kvCacheBuf.data(), kvCacheSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(blockTableDev, blockTableSize, blockTableBuf.data(), blockTableSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(seqLensDev, seqLensSize, seqLensBuf.data(), seqLensSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(centroidsDev, centroidsSize, centroidsBuf.data(), centroidsSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Run kernel
    printf("Launching kernel with grid=%u, cores=%u\n", gridSize, usedCores);
    KernelCall(stream, usedCores, queryDev, kvCacheDev, blockTableDev,
               seqLensDev, centroidsDev, outputDev, tilingDev, tiling);

    // Copy output back
    std::vector<uint8_t> outputBuf(outputSize);
    aclrtMemcpy(outputBuf.data(), outputSize, outputDev, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("output/output.bin", outputBuf.data(), outputSize);

    // Cleanup
    aclrtFree(queryDev);
    aclrtFree(kvCacheDev);
    aclrtFree(blockTableDev);
    aclrtFree(seqLensDev);
    aclrtFree(centroidsDev);
    aclrtFree(outputDev);
    aclrtFree(tilingDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(g_deviceId);
    aclFinalize();

    printf("Done.\n");
    return 0;
}
